OIL_VERSION = "2.5";


IMPLEMENTATION trampoline {
    TASK {
        UINT32 STACKSIZE = 32768;
    };

    ISR {
        UINT32 STACKSIZE = 32768;
    };
};

CPU autosar_virtual {

    OS config {
        STATUS = EXTENDED;

        ERRORHOOK = TRUE;
        USEGETSERVICEID = TRUE;

        TRACE = TRUE {
            FORMAT = json;
            PROC = TRUE;
        };

        BUILD = TRUE {
            APP_SRC = "stub.c";
            TRAMPOLINE_BASE_PATH = "../../third_party/trampoline";
            CFLAGS = "-ggdb";
            APP_NAME = "autosar_virtual";
            LINKER = "gcc";
            SYSTEM = PYTHON;
        };
    };

    APPMODE stdAppmode {};

    /* ----------------------------------------------------------------------
     * OsResources
     * ---------------------------------------------------------------------- */
    RESOURCE DummyResource {
        RESOURCEPROPERTY = STANDARD;
    };

    RESOURCE OsResource_DdsMutex {
    RESOURCEPROPERTY = STANDARD;
    };

    RESOURCE OsResource_DdsTimer {
        RESOURCEPROPERTY = STANDARD;
    };

    RESOURCE OsResource_DdsNetio {
        RESOURCEPROPERTY = STANDARD;
    };

    RESOURCE OsResource_DdsIpQueue {
        RESOURCEPROPERTY = STANDARD;
    };
    

    /* ----------------------------------------------------------------------
     * Alarms
     * ---------------------------------------------------------------------- */
    ALARM DummyAlarm {
        COUNTER = SystemCounter;
        AUTOSTART = FALSE;
        ACTION = ACTIVATETASK {
            TASK = DdsCddInit_Task;
        };
    };

    ALARM DdsCddTimerTickAlarm {
        COUNTER = SystemCounter;

        AUTOSTART = TRUE {
            ALARMTIME = 100;
            CYCLETIME = 100;
            APPMODE = stdAppmode;
        };

        ACTION = ACTIVATETASK {
            TASK = DdsCddTimerTick_Task;
        };
    };

    ALARM DdsCddReadAlarm {
        COUNTER = SystemCounter;

        AUTOSTART = TRUE {
            ALARMTIME = 110;
            CYCLETIME = 500;
            APPMODE = stdAppmode;
        };

        ACTION = SETEVENT {
            TASK = DdsCddRead_Task;
            EVENT = DdsCddPeriodicReadEvent;
        };
    };

    ALARM TcpIp_Alarm {
        COUNTER = SystemCounter;

        AUTOSTART = TRUE {
            ALARMTIME = 50;
            CYCLETIME = 50;
            APPMODE = stdAppmode;
        };

        ACTION = ACTIVATETASK {
            TASK = TcpIp_Task;
        };
    };

    ALARM AppAlarm {
        COUNTER = SystemCounter;

        AUTOSTART = TRUE {
            ALARMTIME = 120;
            CYCLETIME = 1000;
            APPMODE = stdAppmode;
        };

        ACTION = ACTIVATETASK {
            TASK = App_Task;
        };
    };

    /* ----------------------------------------------------------------------
     * Events
     * ---------------------------------------------------------------------- */
    EVENT DdsCddStartEvent {
        MASK = AUTO;
    };

    EVENT DdsCddTimerUpdateEvent {
        MASK = AUTO;
    };

    EVENT DdsCddPeriodicReadEvent {
        MASK = AUTO;
    };

    EVENT DdsCddPeriodicWriteEvent {
        MASK = AUTO;
    };

    EVENT DdsCddProcessDataEvent {
        MASK = AUTO;
    };

    EVENT OsEventDdsIpAssignment {
        MASK = AUTO;
    };

    /* ----------------------------------------------------------------------
     * Tasks
     * ---------------------------------------------------------------------- */
    TASK DdsCddInit_Task {
        PRIORITY = 14;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;
    };

    TASK DdsCddStart_Task {
        PRIORITY = 13;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;

        RESOURCE = OsResource_DdsMutex;
        RESOURCE = OsResource_DdsTimer;
        RESOURCE = OsResource_DdsNetio;

        EVENT = DdsCddStartEvent;
    };

    TASK Bsw_InitTask {
        PRIORITY = 15;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;
    };

    TASK TcpIp_Task {
        PRIORITY = 10;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = OsResource_DdsNetio;
        RESOURCE = OsResource_DdsIpQueue;
    };

    TASK DdsCddIpAddr_Task {
        PRIORITY = 6;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;

        EVENT = OsEventDdsIpAssignment;
        RESOURCE = OsResource_DdsIpQueue;
        RESOURCE = OsResource_DdsMutex;
        RESOURCE = OsResource_DdsNetio;
        RESOURCE = OsResource_DdsTimer;
    };
    
    TASK DdsCddProcessData_Task {
        PRIORITY = 1;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;

        EVENT = DdsCddProcessDataEvent;
        RESOURCE = OsResource_DdsMutex;
        RESOURCE = OsResource_DdsNetio;
    };

    TASK DdsCddTimerTick_Task {
        PRIORITY = 5;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = OsResource_DdsTimer;
    };

    TASK DdsCddWrite_Task {
        PRIORITY = 3;

        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };

        ACTIVATION = 1;
        SCHEDULE = FULL;

        EVENT = DdsCddTimerUpdateEvent;
        EVENT = DdsCddPeriodicWriteEvent;

        RESOURCE = OsResource_DdsMutex;
        RESOURCE = OsResource_DdsTimer;
    };

    TASK DdsCddRead_Task {
        PRIORITY = 3;

        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };

        ACTIVATION = 1;
        SCHEDULE = FULL;

        EVENT = DdsCddPeriodicReadEvent;

        RESOURCE = OsResource_DdsMutex;
        RESOURCE = OsResource_DdsTimer;
    };

    TASK App_Task {
        PRIORITY = 2;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
    };    
};
