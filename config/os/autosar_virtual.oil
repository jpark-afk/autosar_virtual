OIL_VERSION = "2.5";


IMPLEMENTATION trampoline {
    TASK {
        UINT32 STACKSIZE = 32768;
    };

    ISR {
        UINT32 STACKSIZE = 32768;
    };
};

CPU autosar_virtual {

    OS config {
        STATUS = EXTENDED;

        TRACE = TRUE {
            FORMAT = json;
            PROC = TRUE;
        };

        BUILD = TRUE {
            APP_SRC = "stub.c";
            TRAMPOLINE_BASE_PATH = "../../third_party/trampoline";
            CFLAGS = "-ggdb";
            APP_NAME = "autosar_virtual";
            LINKER = "gcc";
            SYSTEM = PYTHON;
        };
    };

    APPMODE stdAppmode {};

    /*
     * ID 0 is reserved by the RTI AUTOSAR PSL assumptions.
     * Keep this resource before OsResource_Dds.
     */
    RESOURCE DummyResource {
        RESOURCEPROPERTY = STANDARD;
    };

    RESOURCE OsResource_DdsMain {
    RESOURCEPROPERTY = STANDARD;
    };

    RESOURCE OsResource_DdsTimer {
        RESOURCEPROPERTY = STANDARD;
    };

    RESOURCE OsResource_DdsNetio {
        RESOURCEPROPERTY = STANDARD;
    };
    

    EVENT RTI_GiveEvent {
        MASK = 1;
    };

    EVENT RTI_TimeoutEvent {
        MASK = 2;
    };

    /*
     * Reserve Alarm ID 0.
     * RTI AUTOSAR PSL requires first_alarm != 0.
     */
    ALARM DummyAlarm {
        COUNTER = SystemCounter;
        AUTOSTART = FALSE;
        ACTION = ACTIVATETASK {
            TASK = RTI_Task;
        };
    };

    ALARM RTI_SemaphoreAlarm {
        COUNTER = SystemCounter;
        AUTOSTART = FALSE;
        ACTION = SETEVENT {
            TASK = RTI_Task;
            EVENT = RTI_TimeoutEvent;
        };
    };

    ALARM DdsCddTimerTickAlarm {
        COUNTER = SystemCounter;

        AUTOSTART = TRUE {
            ALARMTIME = 10;
            CYCLETIME = 10;
            APPMODE = stdAppmode;
        };

        ACTION = ACTIVATETASK {
            TASK = DdsCddTimerTick_Task;
        };
    };

    ALARM DdsCdd100msAlarm {
        COUNTER = SystemCounter;

        AUTOSTART = TRUE {
            ALARMTIME = 1000;
            CYCLETIME = 1000;
            APPMODE = stdAppmode;
        };

        ACTION = ACTIVATETASK {
            TASK = DdsCddReadWrite_Task;
        };
    };

    ALARM TcpIp_5ms_Alarm {
        COUNTER = SystemCounter;

        AUTOSTART = TRUE {
            ALARMTIME = 5;
            CYCLETIME = 5;
            APPMODE = stdAppmode;
        };

        ACTION = ACTIVATETASK {
            TASK = TcpIp_Task;
        };
    };

    TASK RTI_Task {
        PRIORITY = 1;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;

        RESOURCE = OsResource_DdsMain;
        RESOURCE = OsResource_DdsTimer;
        
        EVENT = RTI_GiveEvent;
        EVENT = RTI_TimeoutEvent;
    };

    TASK TcpIp_Task {
        PRIORITY = 10;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = OsResource_DdsNetio;
        RESOURCE = OsResource_DdsMain;
    };

    /* ----------------------------------------------------------------------
     * DDS CDD Virtual RTE Tasks
     * ---------------------------------------------------------------------- */

    EVENT DdsCddProcessDataEvent {
        MASK = AUTO;
    };

    TASK DdsCddProcessData_Task {
        PRIORITY = 1;
        AUTOSTART = TRUE {
            APPMODE = stdAppmode;
        };
        ACTIVATION = 1;
        SCHEDULE = FULL;

        EVENT = DdsCddProcessDataEvent;
        RESOURCE = OsResource_DdsMain;
        RESOURCE = OsResource_DdsNetio;
    };

    TASK DdsCddTimerTick_Task {
        PRIORITY = 5;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = OsResource_DdsTimer;
    };

    TASK DdsCddReadWrite_Task {
        PRIORITY = 2;
        AUTOSTART = FALSE;
        ACTIVATION = 1;
        SCHEDULE = FULL;
        RESOURCE = OsResource_DdsMain;
        RESOURCE = OsResource_DdsTimer;
    };
};
